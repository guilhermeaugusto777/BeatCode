# ==============================================================================
# Spotify Music Graph (BeatCode) - Configuração de Ambiente Backend
# ==============================================================================
# 1. Crie um app em https://developer.spotify.com/dashboard
# 2. Requisitos do Spotify Web API (Development Mode - Fevereiro 2026+):
#    - O proprietário do aplicativo DEVE possuir assinatura Spotify Premium ativa.
#    - Máximo de 1 Client ID por desenvolvedor no modo Development.
#    - Até 5 usuários autorizados cadastrados manualmente na aba "User Management"
#      (allowlist) do Spotify Developer Dashboard.
# 3. Políticas de Redirect URI (RFC 8252 / Spotify OAuth 2.0):
#    - O uso de `http://localhost` é PROIBIDO pelo Spotify.
#    - Utilize obrigatoriamente o IP de loopback explícito IPv4 (`127.0.0.1`)
#      ou IPv6 (`[::1]`) em desenvolvimento local, ou `https://` em produção.
# ==============================================================================

SPOTIPY_CLIENT_ID=seu_client_id_aqui
SPOTIPY_CLIENT_SECRET=seu_client_secret_aqui
SPOTIPY_REDIRECT_URI=http://127.0.0.1:8000/auth/callback

# URL para onde o usuário será redirecionado após concluir o login OAuth 2.0
FRONTEND_URL=http://127.0.0.1:3000
